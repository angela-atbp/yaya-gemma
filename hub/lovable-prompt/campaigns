PART E — NEW SERVER FUNCTION FOR DRILL-DOWN
════════════════════════════════════════════════════════════════════

Add to src/lib/lifecycle-stats.server.ts:

export interface LifecycleSendRow {
  recipient_email: string
  status: string
  sent_at: string
}

export async function getLifecycleSendLog(
  emailKey: string,
  limit = 10
): Promise<LifecycleSendRow[]> {
  const templateName = emailKey.replace(/_/g, '-')
  try {
    const rows = await appDb.query(`
      SELECT recipient_email, status, created_at AS sent_at
      FROM public.email_send_log
      WHERE template_name = $1
        AND status = 'sent'
      ORDER BY created_at DESC
      LIMIT $2
    `, [templateName, limit])
    return rows.rows
  } catch {
    return []
  }
}

