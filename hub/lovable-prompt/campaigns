PART B — LIFECYCLE STATS SERVER FUNCTION
════════════════════════════════════════════════════════════════════

Create src/lib/lifecycle-stats.server.ts

This file reads LIVE stats from the App's email_send_log and
email_lifecycle_log tables via the existing YAYA_DATABASE_URL
postgres connection (same pattern as segments.server.ts).

import { appDb } from '@/lib/app-db.server'  // existing pg connection

export interface LifecycleStat {
  email_key: string
  sent_total: number
  sent_7d: number
  open_count: number
  click_count: number
  failed_count: number
  last_sent_at: string | null
  open_rate: number  // percentage
  click_rate: number
}

export async function getLifecycleStats(): Promise<LifecycleStat[]> {
  // Query App.email_send_log grouped by template_name
  // template_name in email_send_log matches the email_key values
  // (e.g., 'd1-dinner-nudge' is stored as template_name)
  // Note: template_name uses hyphens; email_key uses underscores.
  // Map: replace hyphens with underscores for matching.

  const rows = await appDb.query(`
    SELECT
      replace(template_name, '-', '_')          AS email_key,
      COUNT(*) FILTER (WHERE status = 'sent')   AS sent_total,
      COUNT(*) FILTER (
        WHERE status = 'sent'
          AND created_at > now() - interval '7 days'
      )                                          AS sent_7d,
      COUNT(*) FILTER (WHERE status = 'bounced'
                          OR status = 'failed') AS failed_count,
      MAX(created_at) FILTER (WHERE status = 'sent') AS last_sent_at
    FROM public.email_send_log
    WHERE template_name NOT IN (
      'signup','magiclink','recovery','invite',
      'email_change','reauthentication'
    )
    GROUP BY replace(template_name, '-', '_')
  `)

  // Query open and click counts from email_engagement_events
  // (table: email_engagement_events with event_type='open'/'click')
  const engagementRows = await appDb.query(`
    SELECT
      replace(template_name, '-', '_') AS email_key,
      COUNT(*) FILTER (WHERE event_type = 'open')  AS open_count,
      COUNT(*) FILTER (WHERE event_type = 'click') AS click_count
    FROM public.email_engagement_events
    GROUP BY replace(template_name, '-', '_')
  `)

  // Merge the two result sets
  const engMap = new Map(engagementRows.rows.map(r => [r.email_key, r]))

  return rows.rows.map(r => {
    const eng = engMap.get(r.email_key) ?? { open_count: 0, click_count: 0 }
    const sent = Number(r.sent_total) || 0
    return {
      email_key:    r.email_key,
      sent_total:   sent,
      sent_7d:      Number(r.sent_7d) || 0,
      open_count:   Number(eng.open_count) || 0,
      click_count:  Number(eng.click_count) || 0,
      failed_count: Number(r.failed_count) || 0,
      last_sent_at: r.last_sent_at ?? null,
      open_rate:    sent > 0 ? Math.round((Number(eng.open_count)/sent)*1000)/10 : 0,
      click_rate:   sent > 0 ? Math.round((Number(eng.click_count)/sent)*1000)/10 : 0,
    }
  })
}

If email_engagement_events does not exist in App DB, fall back to
querying open/click from email_send_log.metadata JSONB:
  COUNT(*) FILTER (WHERE metadata->>'opened' = 'true') AS open_count

Wrap entire function in try/catch — on error return [] so the page
never crashes if the App DB connection is unavailable.

